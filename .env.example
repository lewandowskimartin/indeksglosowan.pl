# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role — server-side only. Used by sync + admin writes. Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ────────────────────────────────────────────────────────────────────
# Canonical URL, used for metadata + sitemap. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://example.pl

# ── Admin / cron ────────────────────────────────────────────────────────────
# 32+ random chars. Gates /admin and the /api/admin/* routes.
ADMIN_SECRET=
# Set the same value in Vercel's cron settings.
CRON_SECRET=
